{
  "name": "worker",
  "projectType": "application",
  "sourceRoot": "worker",
  "targets": {
    "build": {
      "command": "npx tsc -p worker/tsconfig.json --noEmit"
    },
    "dev": {
      "command": "lokal cf worker sim"
    },
    "deploy": {
      "command": "lokal cf worker deploy"
    },
    "migrate": {
      "command": "lokal cf db migrate --local"
    }
  }
}
