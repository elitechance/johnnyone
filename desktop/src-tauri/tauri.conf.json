{
  "$schema": "https://raw.githubusercontent.com/nicklasoverworlds/tauri-settings-schema/master/schema.json",
  "productName": "JohnnyOne",
  "version": "0.1.0",
  "identifier": "app.johnnyone.desktop",
  "build": {
    "frontendDist": "../../dist/host-app/browser",
    "devUrl": "http://localhost:4201",
    "beforeDevCommand": "npx nx serve host-app --port 4201",
    "beforeBuildCommand": "rm -rf ../../dist/host-app && npx nx build host-app"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "JohnnyOne",
        "width": 720,
        "height": 560,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "minWidth": 480,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
